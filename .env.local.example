# aimux gateway configuration
# All LLM_* env vars are REQUIRED at startup (no code-level defaults).
# Copy this file to .env.local and fill in real values.

# REQUIRED — PG-only persistence. Start PG first: scripts\pg_up.bat
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/crossborder

# API key for your aimux-compatible provider (e.g. DeepSeek, OpenRouter, etc.)
LLM_API_KEY=sk-replace-me

# Primary model — used by retrieve, quality_score, report nodes
LLM_PRIMARY_PROVIDER=deepseek
LLM_PRIMARY_MODEL=deepseek-chat

# Cheap model — used by hot_filter node
LLM_CHEAP_PROVIDER=deepseek
LLM_CHEAP_MODEL=deepseek-chat

# Optional: override provider base URL (for self-hosted gateways / proxies)
# LLM_BASE_URL=
# Langfuse observability (all three OPTIONAL - missing keys = silent no-op)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
